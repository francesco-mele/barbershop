rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Dati pubblici dell'appuntamento (data, ora, durata, servizio): visibili a chiunque.
    // Scrittura consentita solo al barbiere autenticato.
    match /appuntamenti_pubblici/{appuntamentoId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Dati privati (nome cliente, telefono, note): mai leggibili senza autenticazione.
    match /appuntamenti_privati/{appuntamentoId} {
      allow read, write: if request.auth != null;
    }

    // Lista servizi: lettura pubblica (serve a mostrare i servizi nel calendario pubblico),
    // scrittura solo dal barbiere autenticato.
    match /servizi/{servizioId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Tutto il resto: negato di default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
